# DotSync server — example environment file.
# Copy to .env for local development (the server loads it on startup via godotenv).
# Never commit the real .env: it is listed in .gitignore.

# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dotsync?sslmode=disable

# Signing key for access tokens. Generate with: openssl rand -hex 32
# Must be at least 32 bytes and must differ from SERVER_MASTER_KEY.
JWT_SECRET=

# 32-byte hex key used to encrypt stored project passwords (AES-256-GCM).
# Generate with: openssl rand -hex 32
# WARNING: changing this after passwords are stored makes them unrecoverable.
SERVER_MASTER_KEY=

# GitHub OAuth App client ID (Device Flow — no client secret needed).
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=

# ── Optional ────────────────────────────────────────────────────────────────
# HTTP port (default 8080).
# PORT=8080

# Unpooled connection string used only for migrations. Useful with PgBouncer/Neon;
# falls back to DATABASE_URL when unset.
# DATABASE_URL_DIRECT=

# Migrations directory (default ./migrations).
# MIGRATIONS_PATH=./migrations

# Set to true ONLY when a reverse proxy you control always overwrites
# X-Forwarded-For / X-Real-IP. Otherwise clients can spoof their IP and evade
# rate limits. Leave false for direct internet-facing deployments.
# TRUST_PROXY=false

# CORS is disabled entirely when unset. Set to a single origin (scheme + host +
# port) if a separate browser frontend must call the API with credentials.
# FRONTEND_URL=https://app.example.com

# Database pool tuning (defaults shown).
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME_MIN=30
